# Copia este archivo como server/.env y rellena los valores.
# server/.env NO se sube a git: es donde viven las credenciales.

# --- Base de datos (obligatorio) ---
# Atlas:  mongodb+srv://USUARIO:CONTRASENA@tucluster.xxxxx.mongodb.net/powerlifting?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017/powerlifting
MONGODB_URI=

# --- Sesiones (obligatorio en producción) ---
# Cadena larga y aleatoria. Si la cambias, todos los usuarios tendrán que iniciar sesión otra vez.
# Generar:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Correo de verificación (opcional en local) ---
# Sin estas dos, el código de verificación se imprime en la consola del servidor.
# Con Gmail hace falta una "contraseña de aplicación", no la contraseña de la cuenta.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@powerliftingtracker.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# --- Fotos y vídeos ---
# local (por defecto) = disco del servidor; s3 = bucket de Amazon o compatible.
# MEDIA_DRIVER=local
# MEDIA_LOCAL_DIR=./uploads

# Para S3 hace falta además: npm i @aws-sdk/client-s3
# MEDIA_DRIVER=s3
# AWS_S3_BUCKET=mi-bucket
# AWS_S3_PREFIX=feed
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (o el rol IAM de la instancia)

# Servir el vídeo sin que pase por Node. Es lo que más baja la factura: sin esto se paga
# el tráfico dos veces y el servidor se satura. Ver docs/costes-almacenamiento.md.
# Opción A — dominio del CDN (CloudFront o el dominio público de R2). La más barata:
# MEDIA_PUBLIC_BASE_URL=https://cdn.tudominio.com
# Opción B — URL firmada que caduca, si el contenido debe ser privado:
#   npm i @aws-sdk/s3-request-presigner
# MEDIA_SIGNED_URLS=true
# MEDIA_SIGNED_URL_TTL=3600

# Almacén compatible con S3 que no sea AWS (Cloudflare R2, Backblaze B2…).
# Con esto el mismo driver vale para los dos; solo cambian las variables.
# S3_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com

# --- Despliegue (solo en el servidor de producción) ---
# Dominio público del frontend, para CORS y para los enlaces de los correos.
# APP_URL=http://3.231.3.49:3000
# CORS_ORIGINS=https://tu-app.vercel.app
# PORT=3000
# NODE_ENV=production
